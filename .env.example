# Database connection string (Payload + Postgres — the only supported DB here)
DATABASE_URL=postgresql://playerside:your-password@127.0.0.1:5432/playerside

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Vercel Blob read/write token for the private `playerside-evidence` store
# (Media collection file storage — see src/lib/media/vercelBlobPrivateAdapter.ts).
# Auto-populated in Vercel Production/Preview once the store is linked to the
# project; run `vercel env pull` for local dev. Falls back to local-disk
# storage when absent.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_TOKEN_HERE


# ---- Phase G (G.1) - AI Cofounder + pipeline agents (shared LLM client) ----
# Provider-agnostic env names (LLM_*); DEEPSEEK_* remain as deprecated aliases.
# Key from https://openrouter.ai/keys (OpenRouter hosts DeepSeek V4 Flash).
LLM_API_KEY=
# Base URL of the provider serving LLM_MODEL (default OpenRouter).
LLM_BASE_URL=https://openrouter.ai/api/v1
# Default model id; verified at build time by GET /api/cofounder/health.
# Decision 2026-08-09: the paid deepseek/deepseek-v4-flash (~$0.00000014/token,
# ~14c per million tokens - effectively free) is used because the :free
# variant rotates out of the catalog. Alternatives if ever needed: deepseek-chat
# (DeepSeek direct) or Gemini 3 Flash free (Google AI Studio).
LLM_MODEL=deepseek/deepseek-v4-flash
# Deprecated aliases (still read if LLM_* are unset):
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
LLM_MAX_TOKENS=4000


# ---- Phase I2 - self-hosted OpenSEO (Cofounder seo_lookup tool) ----
# DB SystemSettings values take precedence over these; env vars are for
# bootstrap/CI. Keys stay in the DB / VPS host env - never in the repo.
# OPENSEO_URL=             # base URL of the self-hosted open-seo instance
# OPENSEO_PROJECT_ID=      # open-seo project id (research/rank are project-scoped)
# DATAFORSEO_API_KEY=      # base64 "email:password" from app.dataforseo.com/api-access
# SEO_ROW_CAP_PER_DAY=500  # daily billable-row budget (DataForSEO bills per row)
# Daily LLM call cap across all agents; 0 disables. Counted via agent-logs.
LLM_SPEND_CAP_PER_DAY=1000
# Optional per-role overrides, e.g. LLM_MODEL_DESK_RESEARCHER=deepseek-chat
# (Phase G trending research, G.4): key from https://dashboard.exa.ai -> API Keys.
EXA_API_KEY=
